*.pyc
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Worker runtime state and receipts (never commit)
markers/
worker-run-records/
terminal/
receipts/
logs/
pids/
