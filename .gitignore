# Private profiles.json is ignored everywhere, but the tracked test fixture
# and the documented example must stay visible.
!tests/fixtures/profiles.json
!examples/profiles.example.json

# Packaging and build output
node_modules/
*.tgz
build/
dist/
coverage/
temp/
htmlcov/
.coverage
.coverage.*

# OS noise
.DS_Store
Thumbs.db
